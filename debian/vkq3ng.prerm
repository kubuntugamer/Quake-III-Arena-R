#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Remove update-alternatives
        update-alternatives --remove vkq3ng /usr/bin/vkq3ng 2>/dev/null || true
    ;;

    failed-upgrade)
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0